# .env.example
# Copy this file to .env and fill in real values
# Never commit .env

# Required Settings - Must be set for the application to run
DATABASE_URL=postgresql://role:password@localhost:5432/leaderboard
API_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# Database connection budget. Defaults match the production Essential-0 plan:
# (HSS max 4 + vault size 2) * 2 workers + 2 operational = 14 of 20.
#
# The check in VaultSettings.validate_connection_budget reserves 25% (5 of 20),
# so 15 is the real ceiling and this arrangement sits one under it. HSS moved
# from 5 to 4 to pay for the vault's second connection: 5 was the original
# default rather than a measured figure, and the vault at size 1 cannot serve
# two concurrent requests at all (see VAULT_DB_POOL_SIZE).
#
# Two consumers this formula does not count:
#   - The release dyno takes one connection for `alembic upgrade head` while
#     the web dynos are still up: 14 + 1 = 15. Inside the hard limit of 20, but
#     it spends the reserve this check exists to protect.
#   - Preboot. `heroku features:enable preboot` overlaps old and new dynos, so
#     every per-worker figure doubles: 24 of 20, and new dynos fail to boot
#     mid-deploy. Halve the pool sizes before enabling it.
#
# HSS_PROCESS_COUNT must match the `-w` in the Procfile. Nothing enforces that;
# raising one without the other validates the budget against a fiction.
#
# Deliberately NOT wired to WEB_CONCURRENCY, though it looks like the obvious
# fix for that. Heroku's Python buildpack sets WEB_CONCURRENCY in the dyno
# environment at boot -- min(cores * 2 + 1, RAM_MB / 256) -- so it is a function
# of dyno size, and it does not appear in `heroku config` because it is never a
# config var. Wiring `-w ${WEB_CONCURRENCY}` would therefore make worker count,
# and with it the connection budget, change when the dyno is resized: a 1 GB
# dyno yields 4 workers, 4*4 + 2*4 + 2 = 26 against a ceiling of 15, and the
# budget check aborts the boot. "Resize the dyno, the app stops booting" is a
# worse failure than the drift this would prevent. The Node.js buildpack writes
# the same file name, so with multiple buildpacks the value also depends on
# buildpack order, which this repo does not pin.
#
# Gunicorn's own default for `workers` is WEB_CONCURRENCY, but the Procfile
# passes `-w` explicitly, which overrides it. Keep it explicit.
HSS_DB_POOL_MIN_SIZE=1
HSS_DB_POOL_MAX_SIZE=4
HSS_PROCESS_COUNT=2
DATABASE_CONNECTION_LIMIT=20
DB_OPERATIONAL_CONNECTION_RESERVE=2

# Vault persistence foundation. Leave disabled until a reviewed vault release.
VAULT_ENABLED=false
# A vault request checks out twice in sequence -- once to authenticate, once to
# serve -- so size 1 serializes the whole surface and a second concurrent
# request fails on the pool timeout below.
VAULT_DB_POOL_SIZE=2
VAULT_DB_POOL_TIMEOUT_SECONDS=5

# Pre-authentication IP guard. Bounds how much database work an *unauthenticated*
# caller can force, since verifying a credential costs a query. Deliberately
# loose -- the real limits are the per-principal quotas in app/vault/rate_limit.py,
# and one egress address may legitimately carry several credentials.
# VAULT_PREAUTH_RATE_LIMIT=600/minute
# Point at REDIS_URL to make this guard shared across workers and dynos rather
# than per process. Falls back to in-memory automatically if Redis is unreachable.
# VAULT_RATE_LIMIT_STORAGE_URI=memory://
# Shared-database mode (the initial topology) leaves VAULT_DATABASE_URL unset,
# so it falls back to DATABASE_URL. Set both variables below only after moving
# the vault to a separate database:
# VAULT_DATABASE_URL=postgresql://role:password@host:5432/vault
# VAULT_DATABASE_CONNECTION_LIMIT=20

# Baked into the generated search_vector column at migration time.
# Changing this after migration requires a table rewrite, not a restart.
VAULT_TEXT_SEARCH_CONFIG=english

# Vault embedding provider — see vault ADR 0005. Changing the provider, model,
# or dimensions requires controlled re-embedding, not just a config change.
VAULT_EMBEDDING_PROVIDER=openai
VAULT_EMBEDDING_MODEL=text-embedding-3-small
VAULT_EMBEDDING_PROFILE_ID=openai/text-embedding-3-small:1536
VAULT_EMBEDDING_DIMENSIONS=1536
# PER ATTEMPT, NOT PER REQUEST -- the single easiest value here to get wrong.
# The embedding call retries, so the wall-clock worst case is
#   3 attempts x <this value> + 2 x 4s of capped backoff
# and Heroku's router gives up at 30s. So 5 means 23s (fits, with room for the
# rest of the request) and 10 would mean 38s -- the caller gets a router 503 and
# the work is thrown away. The largest value that fits is 7.3.
#
# Startup refuses anything larger and prints the arithmetic. Do not raise this
# to "give slow calls more room": 5s is already about 4x the measured
# single-query p99 of 1.194s, and because the timeout is per attempt a slow call
# is retried rather than lost. A batch backfill legitimately wants longer, but
# it has no caller waiting -- it passes timeout_seconds to the provider directly
# instead of changing this.
VAULT_EMBEDDING_TIMEOUT_SECONDS=5
# Leave unset so the adapter uses its own default endpoint.
# VAULT_EMBEDDING_BASE_URL=
# Genuinely optional. Left unset the vault
# still serves lexical search: no query is embedded, and every response reports
# vector_status="not_configured" with a null profile_id. CI runs this way.
# A configured key that then fails reports "failed" instead, and logs an error.
# VAULT_EMBEDDING_API_KEY=replace-with-provider-secret

# Vault read access needs no environment secret. Agents authenticate with
# operator-issued credentials stored in vault.vault_agent_credentials:
#   python -m scripts.issue_vault_credential issue --name <agent> --scopes vault:read
# The token is printed once and only its SHA-256 is stored, so a lost token is
# revoked and reissued rather than recovered.

# The one human credential the vault has: the password on the OAuth login page
# a client authorizes itself through (vault ADR 0024).
#
# This holds a BCRYPT HASH, never the password itself. The value is a 60-char
# modular-crypt string starting '$2b$' -- there is no separate encoding step,
# what the generator prints is what goes here, verbatim. Setting the plaintext
# password fails every login.
#
# Generate it with (prompts twice, no echo, touches no database):
#   python -m scripts.hash_vault_operator_password
#
# Here in .env the value is unquoted -- this file is read by the application,
# not by a shell. Setting it through a shell is different: single-quote it
# there, or '$' expansion mangles the hash and the symptom is a correct
# password being rejected.
#   heroku config:set VAULT_OPERATOR_PASSWORD_HASH='$2b$12$...' --app <app>
#
# Unset means the password identity method is not configured, and the login
# refuses -- it never means any password works.
# VAULT_OPERATOR_PASSWORD_HASH=$2b$12$replace-with-the-generated-hash

# Configuration Settings - Necessary with sensible defaults; can be overridden
GUEST_PRUNE_DAYS=30
CACHE_BACKEND=memory        # memory or redis — see ADR 0007
# set to false to disable rate limiting entirely (used for testing, available for ops)
RATE_LIMITER_ENABLED=true   

# Optional Settings - Only needed if using certain features
TEST_DATABASE_URL=postgresql://role:password@localhost:5432/leaderboard_test
REDIS_URL=redis://localhost:6379    # only consulted when CACHE_BACKEND=redis
SENTRY_DSN=https://your-actual-dsn-here

# Steam auth, only needed for /api/auth/steam/*
# STEAM_WEB_API_KEY must be a publisher key and must never ship to clients.
STEAM_WEB_API_KEY=your-steam-publisher-web-api-key
STEAM_APP_ID=480
STEAM_AUTH_IDENTITY=hss
