# .env.example
# Copy this file to .env and fill in real values
# Never commit .env

# Required Settings - Must be set for the application to run
DATABASE_URL=postgresql://role:password@localhost:5432/leaderboard
API_KEY=your-secret-key-here
JWT_SECRET=your-jwt-secret-key-here

# Database connection budget. Defaults match the production Essential-0 plan:
# (HSS max 5 + vault size 1) * 2 workers + 2 operational = 14 of 20.
HSS_DB_POOL_MIN_SIZE=1
HSS_DB_POOL_MAX_SIZE=5
HSS_PROCESS_COUNT=2
DATABASE_CONNECTION_LIMIT=20
DB_OPERATIONAL_CONNECTION_RESERVE=2

# Vault persistence foundation. Leave disabled until a reviewed vault release.
VAULT_ENABLED=false
VAULT_DB_POOL_SIZE=1
VAULT_DB_POOL_TIMEOUT_SECONDS=5
# Shared-database mode (the initial topology) leaves VAULT_DATABASE_URL unset,
# so it falls back to DATABASE_URL. Set both variables below only after moving
# the vault to a separate database:
# VAULT_DATABASE_URL=postgresql://role:password@host:5432/vault
# VAULT_DATABASE_CONNECTION_LIMIT=20

# Baked into the generated search_vector column at migration time.
# Changing this after migration requires a table rewrite, not a restart.
VAULT_TEXT_SEARCH_CONFIG=english

# Vault embedding provider — see vault ADR 0005. Changing the provider, model,
# or dimensions requires controlled re-embedding, not just a config change.
VAULT_EMBEDDING_PROVIDER=openai
VAULT_EMBEDDING_MODEL=text-embedding-3-small
VAULT_EMBEDDING_PROFILE_ID=openai/text-embedding-3-small:1536
VAULT_EMBEDDING_DIMENSIONS=1536
VAULT_EMBEDDING_TIMEOUT_SECONDS=10
# Leave unset so the adapter uses its own default endpoint.
# VAULT_EMBEDDING_BASE_URL=
# Genuinely optional. Left unset the vault
# still serves lexical search: no query is embedded, and every response reports
# vector_status="not_configured" with a null profile_id. CI runs this way.
# A configured key that then fails reports "failed" instead, and logs an error.
# VAULT_EMBEDDING_API_KEY=replace-with-provider-secret

# Vault read access needs no environment secret. Agents authenticate with
# operator-issued credentials stored in vault.vault_agent_credentials:
#   python -m scripts.issue_vault_credential issue --name <agent> --scopes vault:read
# The token is printed once and only its SHA-256 is stored, so a lost token is
# revoked and reissued rather than recovered.

# Configuration Settings - Necessary with sensible defaults; can be overridden
GUEST_PRUNE_DAYS=30
CACHE_BACKEND=memory        # memory or redis — see ADR 0007
# set to false to disable rate limiting entirely (used for testing, available for ops)
RATE_LIMITER_ENABLED=true   

# Optional Settings - Only needed if using certain features
TEST_DATABASE_URL=postgresql://role:password@localhost:5432/leaderboard_test
REDIS_URL=redis://localhost:6379    # only consulted when CACHE_BACKEND=redis
SENTRY_DSN=https://your-actual-dsn-here

# Steam auth, only needed for /api/auth/steam/*
# STEAM_WEB_API_KEY must be a publisher key and must never ship to clients.
STEAM_WEB_API_KEY=your-steam-publisher-web-api-key
STEAM_APP_ID=480
STEAM_AUTH_IDENTITY=hss
