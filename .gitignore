# =============================================================================
# Python / FastAPI backend
# =============================================================================

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
*.egg
MANIFEST

# Virtual environments
.venv/
venv/
env/
ENV/

# .python-version is deliberately tracked, not ignored: Heroku's buildpack
# reads it as the runtime pin. Point a local pyenv elsewhere with
# PYENV_VERSION rather than editing it.

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
.hypothesis/

# Type checkers
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Jupyter (in case of ad-hoc analysis)
.ipynb_checkpoints/

# =============================================================================
# Secrets and environment
# =============================================================================
.env
.env.local
.env.*.local
*.pem
*.key

# Keep example files committed
!.env.example

# =============================================================================
# Logs and databases
# =============================================================================
*.log
logs/
*.sqlite
*.sqlite3
*.db

# =============================================================================
# Editor / IDE
# =============================================================================
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*.swn
*~
.project
.pydevproject

# =============================================================================
# OS
# =============================================================================
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# =============================================================================
# Heroku
# =============================================================================
# Heroku doesn't produce local artifacts typically, but if you use
# `heroku local` with a .env, it's already covered above.

# =============================================================================
# Claude Code / agent state
# =============================================================================
# Per-machine agent state lives here: settings.local.json and, notably,
# .claude/worktrees/ — each a full nested checkout of this repo. None of it
# should be tracked. (CLAUDE.md lives at the repo root, not under .claude/, so
# it stays committed.) If shared team config is ever wanted, force-add it
# explicitly, e.g.: git add -f .claude/settings.json
.claude/